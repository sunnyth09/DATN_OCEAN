APP_NAME=OceanAPI
APP_ENV=testing
APP_KEY=base64:dGVzdGluZ2tleWZvcmNpdGVzdGluZzEyMzQ1Njc4OTA=
APP_DEBUG=true
APP_URL=http://localhost

# ── Database: SQLite in-memory (cực nhanh, không cần MySQL) ──
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ── Tắt các dịch vụ ngoài để test chạy offline ──
CACHE_DRIVER=array
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log

# ── Redis: không dùng khi test ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── JWT (giá trị test giả) ──
JWT_SECRET=testing-jwt-secret-key-for-ci-only
JWT_TTL=480
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_GRACE_PERIOD=10

# ── Turnstile: luôn bật verify để test đúng logic ──
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Scout: tắt khi test ──
SCOUT_DRIVER=null

# ── Telescope/Pulse: tắt ──
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
