APP_NAME=OceanAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8383
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ocean_db
DB_USERNAME=root
DB_PASSWORD=root


JWT_SECRET=
# JWT Token TTL (phút) — 480 = 8 tiếng (1 ngày làm việc)
JWT_TTL=480
# JWT Refresh TTL (phút) — 20160 = 14 ngày
JWT_REFRESH_TTL=20160
# Grace period (giây) để tránh lỗi khi nhiều request song song cùng lúc
JWT_BLACKLIST_GRACE_PERIOD=10
#Email (Laravel SMTP Mailer)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ocean Shop"

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
URL_CORS=http://127.0.0.1:3302
URL_CORS_LOCAL=http://localhost:3302

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=123456
REVERB_APP_KEY=ocean_realtime_key_2024
REVERB_APP_SECRET=ocean_secret_key_very_secure
REVERB_HOST="localhost"
REVERB_PORT=8383
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_BASE_URL="${APP_URL}"

GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TIMEOUT=10
GHN_SERVICE_TYPE_ID=2
GHN_REQUIRED_NOTE=KHONGCHOXEMHANG
GHN_DEFAULT_WEIGHT=500
GHN_MIN_WEIGHT=10
GHN_SENDER_NAME="OCEAN SHOP"
GHN_SENDER_PHONE=0909000000
GHN_SENDER_ADDRESS="123 Đường ABC"
GHN_SENDER_WARD_CODE=20308
GHN_SENDER_DISTRICT_ID=1444
GHN_WEBHOOK_ALLOWED_IPS=
GHN_TRACKING_URL=https://donhang.ghn.vn

# Facebook
FACEBOOK_ID=your_facebook_id_here
FACEBOOK_SECRET=your_facebook_secret_here
FACEBOOK_REDIRECT=http://localhost:3302/api/auth/facebook/callback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here


#THANH TOAN VN PAY
VNP_TMN_CODE=			
VNP_HASH_SECRET=			
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html			
VNP_RETURN_URL=http://localhost:3302/payment/result			

# THANH TOAN MOMO
MOMO_PARTNER_CODE=				
MOMO_ACCESS_KEY=				
MOMO_SECRET_KEY=				
MOMO_ENDPOINT=			
MOMO_REDIRECT_URL=			
MOMO_IPN_URL=
STORE_LAT=12.7098567
STORE_LNG=108.0733147

# REDIS CACHE
CACHE_DRIVER=redis

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SCOUT + MEILISEARCH
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
VITE_MEILISEARCH_HOST=http://localhost:7700
VITE_MEILISEARCH_KEY=masterKey

# ═══ AI VIRTUAL TRY-ON ═══
# Mode: 'mock' (default, không cần API key) hoặc 'live' (cần API key thật)
TRYON_MODE=mock
# Provider: fashn, api4ai, vmodel, lightx (hoặc tên provider bạn dùng)
TRYON_PROVIDER=fashn
# URL endpoint của provider (ví dụ FASHN.ai)
TRYON_API_URL=https://api.fashn.ai/v1/run
# API key — KHÔNG ĐƯỢC commit key thật vào repo
TRYON_API_KEY=
# Timeout khi gọi provider (ms)
TRYON_TIMEOUT_MS=60000
# Frontend: cho phép hiện nút Try-On (true/false)
VITE_TRYON_ENABLED=true