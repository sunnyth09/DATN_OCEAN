VNP_RETURN_URL=http://localhost:3302/payment/result			

# THANH TOAN MOMO
MOMO_PARTNER_CODE=				
MOMO_ACCESS_KEY=				
MOMO_SECRET_KEY=				
MOMO_ENDPOINT=			
MOMO_REDIRECT_URL=			
MOMO_IPN_URL=
STORE_LAT=12.7098567
STORE_LNG=108.0733147

# REDIS CACHE
CACHE_DRIVER=redis

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SCOUT + MEILISEARCH
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
VITE_MEILISEARCH_HOST=http://localhost:7700
VITE_MEILISEARCH_KEY=masterKey