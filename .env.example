APP_NAME=OceanAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8383
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ocean_db
DB_USERNAME=root
DB_PASSWORD=root


JWT_SECRET=
# JWT Token TTL (phút) — 480 = 8 tiếng (1 ngày làm việc)
JWT_TTL=480
# JWT Refresh TTL (phút) — 20160 = 14 ngày
JWT_REFRESH_TTL=20160
# Grace period (giây) để tránh lỗi khi nhiều request song song cùng lúc
JWT_BLACKLIST_GRACE_PERIOD=10
#Email (Laravel SMTP Mailer)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ocean Shop"

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
URL_CORS=http://127.0.0.1:3302
URL_CORS_LOCAL=http://localhost:3302

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=123456
REVERB_APP_KEY=ocean_realtime_key_2024
REVERB_APP_SECRET=ocean_secret_key_very_secure
REVERB_HOST="localhost"
REVERB_PORT=8383
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_BASE_URL="${APP_URL}"

# VITE_API_GHN="${TOKEN_API_GHN}"
# TOKEN_API_GHN=your_token_api_ghn_here

VITE_TOKEN_GHN=your_vite_token_ghn_here
VITE_SHOPID_GHN=your_vite_shopid_ghn_here
FACEBOOK_ID=your_facebook_id_here
FACEBOOK_SECRET=your_facebook_secret_here
FACEBOOK_REDIRECT=http://localhost:3302/api/auth/facebook/callback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here


#THANH TOAN VN PAY
VNP_TMN_CODE=			
VNP_HASH_SECRET=			
